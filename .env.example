# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV="development"
CLIENT_URL="http://localhost:3000"

# MongoDB Connection (if omitted in local dev, falls back to local mongodb-memory-server if available)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blinkupz"

# JWT Authentication
JWT_SECRET="replace-with-a-strong-random-64-char-secret"
JWT_EXPIRES_IN="7d"

# Cloudinary Media Storage (Server-Side & Unsigned Client Preset if used)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Real OTP Provider Configuration
# Supported providers: "resend" | "twilio" | "webhook"
OTP_PROVIDER="resend"

# Resend Email OTP Configuration (when OTP_PROVIDER=resend)
RESEND_API_KEY=""
EMAIL_FROM="BlinkUpZ <noreply@blinkupx.zumooflex.shop>"

# Twilio SMS Configuration (when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Custom SMS Webhook Configuration (when OTP_PROVIDER=webhook)
OTP_WEBHOOK_URL=""
OTP_WEBHOOK_SECRET=""

# Web Push / VAPID
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:noreply@blinkupx.zumooflex.shop"

# LiveKit Cloud (Backend Only — Never expose API Secret to client)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
CALL_RING_TIMEOUT_MS="35000"

# Blink AI Assistant (Backend Only — Never expose API keys or internal config to client)
GEMINI_PRIMARY_API_KEY=""
GEMINI_SECONDARY_API_KEY=""
GEMINI_PRIMARY_MODEL="gemini-4-hydrogen"
GEMINI_SECONDARY_MODEL="gemini-3.1-flash-lite"
GEMINI_REQUEST_TIMEOUT_MS="25000"
GEMINI_COOLDOWN_MS="60000"
AI_CONTEXT_MESSAGE_LIMIT="12"
AI_CONTEXT_CHAR_BUDGET="6000"
AI_USER_RATE_LIMIT_MAX="8"
AI_USER_RATE_LIMIT_WINDOW_MS="60000"
AI_CHAT_RATE_LIMIT_MAX="12"
AI_CHAT_RATE_LIMIT_WINDOW_MS="60000"

# Client Environment Variables (Vite)
VITE_API_URL="/api"
VITE_SOCKET_URL=""
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
